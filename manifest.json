{
  "manifest_version": 3,
  "name": "Mind Grapes",
  "version": "2026.7.1",
  "description": "Bookmark the current page into your Mind Grapes second brain.",
  "action": {
    "default_title": "Save to Mind Grapes",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "identity",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*/*"
  ]
}
